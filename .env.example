# TradingView AI Webhook Server & Execution Configuration

# Security passphrase for TradingView alerts
WEBHOOK_SECRET=super_secret_tradingview_passphrase

# Dry run mode: "true" to simulate trades safely, "false" to execute real paper/live trades
DRY_RUN=true

# Alpaca Trading API (for automated paper trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
